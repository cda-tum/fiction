    lyt: mnt.pyfiction.sidb.sidb_layout,
    *,
    threshold_bdl_interdistance: float = 2.0,
    minimum_distance: float = 0.75,
    maximum_distance: float = 1.5,
    wire_selection: bdl_wire_selection = ...,
) -> list[bdl_wire]:
    """
    Chain BDL pairs into wires along the SiDB lattice.
    The keyword options select pair-distance bounds, inter-pair distance, and wire types.

    Args:
        threshold_bdl_interdistance: Maximum separation between BDL pairs in one wire in nm.
        minimum_distance: Minimum SiDB separation for a BDL pair in nm.
        maximum_distance: Maximum SiDB separation for a BDL pair in nm.
        wire_selection: Select all wires, input wires, or output wires.
    """

class operational_status(enum.Enum):
    """Possible operational status of a layout."""

    OPERATIONAL = 0
    """The layout is operational."""

    NON_OPERATIONAL = 1
    """The layout is non-operational."""

class operational_condition(enum.Enum):
    """
    Condition to decide whether a layout is operational or non-
    operational.
    """

    TOLERATE_KINKS = 0
    """
    Even if the I/O pins show kinks, the layout is still considered as
    operational.
    """

    REJECT_KINKS = 1
    """
    The I/O pins are not allowed to show kinks. If kinks exist, the layout
    is considered non-operational.
    """

class operational_analysis_strategy(enum.Enum):
    """
    Simulation method to determine if the layout is operational or non-
    operational. There are three possible
    strategies:

    - `SIMULATION_ONLY`: This setting does not apply any filtering
      strategies to determine if the layout is
    operational. Instead, it relies solely on physical simulation to make
    this determination.
    - `FILTER_ONLY`: This setting does only apply filtering strategies to
      determine if the layout is
    non-operational. If the layout passes all filtering strategies, it is
    considered operational. This is only an approximation. It may be
    possible that the layout is non-operational, but the filtering
    strategies do not detect it. Sweeping a parameter space this way is
    called the operational domain sketch. The filtering steps are only
    defined when kinks are rejected, and they enumerate the charge
    configurations of the canvas that the layout's `LOGIC` dots define, so
    this setting is only effective with `REJECT_KINKS` on a layout that
    has such dots.
    - `FILTER_THEN_SIMULATION`: Before a physical simulation is conducted,
      the algorithm checks if filtering
    strategies have detected whether the layout is non-operational. This
    only provides any runtime benefits if kinks are rejected.
    """

    SIMULATION_ONLY = 0
    """
    Do not apply filter strategies to determine whether the layout is
    operational. Instead, rely solely on physical simulation.
    """

    FILTER_ONLY = 1
    """
    Apply filtering exclusively to determine whether the layout is non-
    operational. If the layout passes all filter steps, it is considered
    operational. Sweeping a parameter space this way is called the
    operational domain sketch.

    Note:
        This is an extremely fast approximation that may sometimes lead to
        false positives. It requires `REJECT_KINKS` and a layout with
        `LOGIC` dots; without either, no filter step runs.
    """

    FILTER_THEN_SIMULATION = 2
    """
    Before a physical simulation is conducted, the algorithm checks if
    filter strategies can determine that the layout is non-operational.
    This only provides any runtime benefits if kinks are rejected.
    """

@overload
def is_operational(
    lyt: mnt.pyfiction.sidb.sidb_layout,
    spec: Sequence[mnt.pyfiction.synthesis.dynamic_truth_table],
    *,
    timeout: int = ...,
    base: int = 3,
    mu_minus: float = -0.32,
    epsilon_r: float = 5.6,
    lambda_tf: float = 5.0,
    sim_engine: mnt.pyfiction.sidb.simulation.sidb_simulation_engine = ...,
    threshold_bdl_interdistance: float = 2.0,
    minimum_distance: float = 0.75,
    maximum_distance: float = 1.5,
    input_bdl_config: input_bdl_configuration = ...,
    op_condition: operational_condition = ...,
    strategy_to_analyze_operational_status: operational_analysis_strategy = ...,
) -> tuple[operational_status, int]:
    """
    Determine whether the SiDB layout implements the supplied truth tables for every input pattern.
    The keyword options select physical values, simulation, BDL encoding, and operational analysis.
    Overloads accept supplied wires or one layout per input pattern.

    Args:
        timeout: Execution budget in milliseconds.
        base: Number of charge states: 2 for negative and neutral, or 3 to include positive charges.
        mu_minus: Negative-charge transition energy in eV.
        epsilon_r: Relative permittivity (dimensionless).
        lambda_tf: Thomas-Fermi screening distance in nm.
        sim_engine: SiDB simulation engine used for operational analysis.
        threshold_bdl_interdistance: Maximum separation between BDL pairs in one wire in nm.
        minimum_distance: Minimum SiDB separation for a BDL pair in nm.
        maximum_distance: Maximum SiDB separation for a BDL pair in nm.
        input_bdl_config: Input encoding: perturber absence or perturber distance.
        op_condition: Condition used to decide whether the layout is operational.
        strategy_to_analyze_operational_status: Operational-status analysis strategy.
    """

