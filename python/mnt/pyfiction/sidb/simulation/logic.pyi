class input_bdl_configuration(enum.Enum):
    PERTURBER_ABSENCE_ENCODED = 1
    """
    A perturber is used to set the input to `1`, while the absence of a
    perturber represents a `0` (as described in
    https://ieeexplore.ieee.org/abstract/document/8963859).
    """

    PERTURBER_DISTANCE_ENCODED = 0
    """
    An input of `1` is generated by placing a perturber closer to the BDL
    wire, whereas a `0` is produced by positioning the perturber farther
    away (as described in https://dl.acm.org/doi/10.1145/3489517.3530525).
    """

class bdl_input_iterator:
    """
    Iterator that assigns the input patterns to the input BDL pairs of an
    SiDB layout. Incrementing the iterator advances the input pattern;
    dereferencing it yields the layout with that pattern applied. Every
    input BDL pair encodes one bit: a `1` keeps the SiDB closer to the
    wire's end, a `0` keeps the other one (perturber-distance encoding) or
    none (perturber-absence encoding). Bit `i` of the pattern belongs to
    the `i`-th input pair in layout order, with the first pair as the most
    significant bit.
    """

    @overload
    def __init__(
        self,
        lyt: mnt.pyfiction.sidb.sidb_layout,
        *,
        threshold_bdl_interdistance: float = 2.0,
        minimum_distance: float = 0.75,
        maximum_distance: float = 1.5,
        input_bdl_config: input_bdl_configuration = ...,
    ) -> None:
        """
        Iterate over SiDB input patterns using the selected BDL encoding.

        Args:
            threshold_bdl_interdistance: Maximum separation between BDL pairs in one wire in nm.
            minimum_distance: Minimum SiDB separation for a BDL pair in nm.
            maximum_distance: Maximum SiDB separation for a BDL pair in nm.
            input_bdl_config: Input encoding: perturber absence or perturber distance.
        """

    @overload
    def __init__(
        self,
        lyt: mnt.pyfiction.sidb.sidb_layout,
        input_wires: Sequence[bdl_wire],
        *,
        minimum_distance: float = 0.75,
        maximum_distance: float = 1.5,
        input_bdl_config: input_bdl_configuration = ...,
    ) -> None:
        """
        Iterate over SiDB input patterns using the selected BDL encoding.

        Args:
            minimum_distance: Minimum SiDB separation for a BDL pair in nm.
            maximum_distance: Maximum SiDB separation for a BDL pair in nm.
            input_bdl_config: Input encoding: perturber absence or perturber distance.
        """

    def __iter__(self) -> bdl_input_iterator: ...
    def __next__(self) -> mnt.pyfiction.sidb.sidb_layout:
        """
        The layout with the current input pattern applied.

        Returns:
            The layout.
        """

    def __eq__(self, m: int) -> bool:
        """
        Whether the current input pattern is `m`.

        Args:
            m: The pattern to compare with.

        Returns:
            `true` if the patterns are equal.
        """

    def __ne__(self, m: int) -> bool: ...
    def __lt__(self, m: int) -> bool: ...
    def __le__(self, m: int) -> bool: ...
    def __gt__(self, m: int) -> bool: ...
    def __ge__(self, m: int) -> bool: ...
    def __add__(self, m: int) -> bdl_input_iterator:
        """
        Returns an iterator `m` patterns ahead.

        Args:
            m: The number of patterns to advance.

        Returns:
            The advanced iterator.
        """

    def __iadd__(self, m: int) -> Self:
        """
        Advances by `m` patterns.

        Args:
            m: The number of patterns to advance.

        Returns:
            Reference to `this`.
        """

    def __sub__(self, m: int) -> bdl_input_iterator:
        """
        Returns an iterator `m` patterns behind.

        Args:
            m: The number of patterns to go back.

        Returns:
            The iterator.
        """

    def __isub__(self, m: int) -> Self:
        """
        Goes back by `m` patterns.

        Args:
            m: The number of patterns to go back.

        Returns:
            Reference to `this`.
        """

    def __getitem__(self, m: int) -> bdl_input_iterator:
        """
        Returns an iterator `m` patterns ahead.

        Args:
            m: The number of patterns to advance.

        Returns:
            The advanced iterator.
        """

    def num_input_pairs(self) -> int:
        """
        Number of input BDL pairs.

        Returns:
            The number of input pairs.
        """

    def get_current_input_index(self) -> int:
        """
        The current input pattern.

        Returns:
            The pattern.
        """

    def get_layout(self) -> mnt.pyfiction.sidb.sidb_layout:
        """
        Returns the layout that represents the current input state, equivalent to dereferencing the iterator.
        """

