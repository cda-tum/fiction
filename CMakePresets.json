{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FICTION_ENABLE_CACHE": "ON"
      }
    },
    {
      "name": "cpp-tests",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "FICTION_TEST": "ON",
        "FICTION_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "solvers",
      "hidden": true,
      "cacheVariables": {
        "FICTION_Z3": "ON",
        "FICTION_ALGLIB": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "C++ tests (Debug)",
      "description": "Fast local C++ test builds with precompiled headers and reduced debug information",
      "inherits": "cpp-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FICTION_ENABLE_PCH": "ON",
        "FICTION_LIGHTWEIGHT_DEBUG_BUILDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "C++ tests (Release)",
      "description": "Optimized C++ test builds with IPO when supported",
      "inherits": "cpp-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FICTION_ENABLE_IPO": "ON"
      }
    },
    {
      "name": "sanitizers",
      "displayName": "C++ tests with sanitizers",
      "description": "Debug tests with AddressSanitizer and UndefinedBehaviorSanitizer on Linux and macOS",
      "inherits": "debug",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "cacheVariables": {
        "FICTION_ENABLE_SANITIZER_ADDRESS": "ON",
        "FICTION_ENABLE_SANITIZER_UNDEFINED": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "C++ test coverage",
      "description": "Debug tests with Z3, ALGLIB, and coverage instrumentation for lcov",
      "inherits": ["cpp-tests", "solvers"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_UNITY_BUILD": "OFF",
        "FICTION_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "experiments",
      "displayName": "Research experiments",
      "description": "Optimized experiment executables with Z3 and ALGLIB enabled",
      "inherits": ["base", "solvers"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FICTION_EXPERIMENTS": "ON",
        "FICTION_TEST": "OFF",
        "FICTION_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "pyfiction",
      "displayName": "Python binding development",
      "description": "Build the pyfiction extension modules directly with the wheel build type",
      "inherits": ["base", "solvers"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FICTION_TEST": "OFF",
        "FICTION_PYTHON_BINDINGS": "ON"
      }
    },
    {
      "name": "lint",
      "displayName": "Clang-Tidy compilation database",
      "description": "Generate compile commands for tests, benchmarks, experiments, and Python bindings",
      "inherits": ["cpp-tests", "solvers"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_UNITY_BUILD": "OFF",
        "FICTION_BENCHMARK": "ON",
        "FICTION_EXPERIMENTS": "ON",
        "FICTION_PYTHON_BINDINGS": "ON"
      }
    },
    {
      "name": "ci-common",
      "hidden": true,
      "inherits": ["cpp-tests", "solvers"],
      "cacheVariables": {
        "FICTION_BENCHMARK": "OFF",
        "FICTION_EXPERIMENTS": "OFF",
        "FICTION_ENABLE_PCH": "ON"
      }
    },
    {
      "name": "ci-debug",
      "displayName": "CI C++ tests (Debug)",
      "description": "Debug test matrix baseline with Z3 and ALGLIB enabled",
      "inherits": ["ci-common", "debug"]
    },
    {
      "name": "ci-release",
      "displayName": "CI C++ tests (Release)",
      "description": "Release test matrix baseline with Z3 and ALGLIB enabled",
      "inherits": "ci-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-codeql",
      "displayName": "CI CodeQL analysis",
      "description": "Debug test build with precompiled headers disabled for CodeQL extraction",
      "inherits": "ci-debug",
      "cacheVariables": {
        "FICTION_ENABLE_PCH": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "experiments",
      "configurePreset": "experiments"
    },
    {
      "name": "pyfiction",
      "configurePreset": "pyfiction"
    },
    {
      "name": "lint",
      "configurePreset": "lint"
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci-debug"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release"
    },
    {
      "name": "ci-codeql",
      "configurePreset": "ci-codeql"
    }
  ],
  "testPresets": [
    {
      "name": "test-defaults",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug",
      "inherits": "test-defaults",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "test-defaults",
      "configurePreset": "release"
    },
    {
      "name": "sanitizers",
      "inherits": "test-defaults",
      "configurePreset": "sanitizers",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:$penv{UBSAN_OPTIONS}"
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "coverage",
      "inherits": "test-defaults",
      "configurePreset": "coverage"
    },
    {
      "name": "ci-debug",
      "inherits": "test-defaults",
      "configurePreset": "ci-debug"
    },
    {
      "name": "ci-release",
      "inherits": "test-defaults",
      "configurePreset": "ci-release"
    }
  ]
}
