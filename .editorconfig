root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{c,cpp,h,hpp,py,pyi}]
indent_size = 4
max_line_length = 120

[{CMakeLists.txt,*.cmake,CMakeLists.txt.in,*.cmake.in}]
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
